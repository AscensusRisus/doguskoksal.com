---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkList from '../components/WorkList.astro';
import ContactLinks from '../components/ContactLinks.astro';
import { siteConfig } from '../data/site';
import { getPublishedProjects } from '../lib/projects';

const projects = await getPublishedProjects();
---

<BaseLayout>
  <div class="site-motifs" aria-hidden="true">
    <div class="note-background-test">
      <span class="note-symbol note-symbol-light"></span>
      <span class="note-symbol note-symbol-heavy"></span>
      <span class="note-symbol note-symbol-eighth"></span>
      <span class="note-symbol note-symbol-quarter"></span>
    </div>
    <span class="kyoko-ribbon"></span>
    <img class="chiaki-hairpin" src="/motifs/chiaki-hairpin.png?v=2" alt="" />
  </div>
      <section class="shell hero" aria-labelledby="intro-title">
        <p class="eyebrow">Software engineer / computer programming graduate</p>
        <h1 id="intro-title">I'm Doğuş.<br /><em>I make ideas work.</em></h1>
    <div class="hero-bottom">
      <p class="lede">I build practical software across web development, cybersecurity, and applied AI — turning difficult ideas into useful tools.</p>
      <a class="text-link" href="#about">More about me</a>
    </div>
    <div class="status-line" aria-label="Current status"><span>Based in Turkey</span><span>Open to software engineering roles</span><span>Resume updated {siteConfig.resumeUpdated}</span></div>
    <div class="resume-cta"><span>Prefer a concise overview?</span><a class="resume-button" href="/resume/Dogus-Koksal-Resume.pdf">Resume</a><a class="resume-download" href="/resume/Dogus-Koksal-Resume.pdf" download aria-label="Download resume" title="Download resume"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v11"></path><path d="m7.5 10.5 4.5 4.5 4.5-4.5"></path><path d="M4 20h16"></path></svg></a></div>
  </section>

  <section class="shell now-strip" aria-labelledby="now-heading">
    <div><p class="eyebrow">Now / {siteConfig.nowLabel}</p><h2 id="now-heading">Building the next chapter.</h2></div>
    <p class="now-copy">I'm looking for software engineering roles where I can contribute across full-stack development, cybersecurity, and applied AI while continuing to grow through real product work.</p>
  </section>

  <section class="shell section-block" aria-labelledby="work-heading">
    <div class="section-heading"><p class="eyebrow">01 / Selected projects</p><a class="text-link" href="/projects">View all projects</a></div>
    <h2 id="work-heading">Projects with purpose.</h2>
    <WorkList projects={projects} limit={2} />
  </section>

  <section class="shell section-block" id="experience" aria-labelledby="experience-heading">
    <div class="section-heading"><p class="eyebrow">02 / Experience</p><span class="section-note">2026</span></div>
    <h2 id="experience-heading">Engineering in practice.</h2>
    <div class="experience-entry">
      <div><h3>Software Developer Intern</h3><p class="entry-meta">SecHard / Remote / Jan-Jun 2026</p></div>
      <div class="prose"><p>Developed and maintained full-stack features across a cybersecurity platform using Angular, TypeScript, Node.js, PrimeNG, MongoDB, and REST APIs.</p><ul><li>Extended PDF and CSV reporting, refined interactive tables, and updated reusable application components.</li><li>Maintained and validated security-hardening recipes across operating systems, network devices, databases, and infrastructure products.</li><li>Executed 500+ Windows hardening checks, diagnosed Docker-based failures, and built a Python local RAG chatbot demo for platform guidance.</li></ul></div>
    </div>
  </section>

  <section class="shell split-section" id="about" aria-labelledby="about-heading">
    <div><p class="eyebrow">03 / A little context</p><h2 id="about-heading">Curiosity, applied.</h2></div>
    <div class="prose"><p>My path into tech started with BTK's Datathon 2023. Preparing for that competition showed me how much I enjoy breaking an unfamiliar problem into smaller pieces and building toward a working answer.</p><p>Since then I've completed bootcamps in machine learning and data science, graduated in computer programming, and gained hands-on experience building cybersecurity platform features. I'm especially drawn to work where thoughtful engineering can make complex systems clearer, safer, or more useful.</p></div>
  </section>

  <section class="shell split-section capabilities" aria-labelledby="capabilities-heading">
    <div><p class="eyebrow">04 / Current toolkit</p><h2 id="capabilities-heading">Tools I use to build.</h2></div>
    <div class="skills-groups"><div><p class="skill-label">Used professionally</p><p>Python · TypeScript · Angular · Node.js · PrimeNG · REST APIs · MongoDB · Docker</p></div><div><p class="skill-label">Built projects with</p><p>React · Vite · Cloudflare Workers · D1/SQLite · Drizzle ORM · Ollama · RAG · RoBERTa · Computer Vision</p></div><div><p class="skill-label">Currently exploring</p><p>Browser extension architecture · API pairing and permissions · Multimodal safety evaluation</p></div></div>
  </section>

  <section class="shell split-section activities" aria-labelledby="activities-heading">
    <div><p class="eyebrow">05 / Activities</p><h2 id="activities-heading">Outside the code.</h2></div>
    <div class="activity-entry"><div><h3>YetGen Participant</h3><p class="entry-meta">Yetkin Gençler / Remote / Aug-Nov 2023</p></div><div class="prose"><p>Completed YetGen's 12-week development program, combining technology literacy with teamwork, presentation, career planning, social innovation, and entrepreneurship.</p><p>Developed an impact-oriented initiative through the GirişGen ideathon process aligned with the UN Sustainable Development Goals.</p><p><a class="text-link" href="/activities">View activity details</a></p></div></div>
  </section>

  <section class="shell contact-section" aria-labelledby="contact-heading">
    <p class="eyebrow">06 / Say hello</p><h2 id="contact-heading">Have something in mind?</h2><p class="lede">The best way to reach me is by email. I'm always interested in good questions and thoughtful projects.</p><ContactLinks />
  </section>
</BaseLayout>
