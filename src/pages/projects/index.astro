---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkList from '../../components/WorkList.astro';
import { getPublishedProjects } from '../../lib/projects';
const projects = await getPublishedProjects();
---

<BaseLayout title="Projects — Doğuş Köksal">
  <section class="shell page-intro"><p class="eyebrow">Projects / Index</p><h1>Projects, systems,<br /><em>and practical experiments.</em></h1><p class="lede">A focused record of software I have built, maintained, and taken from an idea toward a working product.</p></section>
  <section class="shell section-block" aria-labelledby="all-work-heading"><h2 id="all-work-heading" class="sr-only">All projects</h2><WorkList projects={projects} /></section>
</BaseLayout>
