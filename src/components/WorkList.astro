---
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'work'>[];
  limit?: number;
}

const { projects, limit } = Astro.props;
const visibleProjects = limit ? projects.slice(0, limit) : projects;
---

<div class="work-list">
  {visibleProjects.map((project, index) => (
    <a class="work-row" href={`/work/${project.id}`}>
      <span class="work-index">0{index + 1}</span>
      <span class="work-title">{project.data.title}</span>
      <span class="work-summary"><span>{project.data.summary}</span>{project.data.tags.length > 0 && <small>{project.data.tags.join(' · ')}</small>}</span>
      <span class="work-meta">{project.data.year}</span>
      <span class="arrow" aria-hidden="true">↗</span>
    </a>
  ))}
</div>
