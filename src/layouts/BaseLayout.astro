---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Doğuş Köksal — Software Engineer', description = 'A personal portfolio for Doğuş Köksal.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://www.doguskoksal.com').toString();
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Doğuş Köksal',
  url: 'https://www.doguskoksal.com',
  jobTitle: 'Software Engineer',
  address: { '@type': 'PostalAddress', addressCountry: 'TR' },
  sameAs: [
    'https://github.com/AscensusRisus',
    'https://www.linkedin.com/in/dogus-koksal/',
    'https://medium.com/@doguskoksl',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f2f0eb" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Doğuş Köksal" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600&family=Playfair+Display:ital,wght@0,500;1,500&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600&family=Playfair+Display:ital,wght@0,500;1,500&display=swap" rel="stylesheet" /></noscript>
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
    <script is:inline>
      const savedTheme = localStorage.getItem('theme-preference') || 'system';
      const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.dataset.theme = savedTheme === 'system' ? systemTheme : savedTheme;
      document.documentElement.dataset.themePreference = savedTheme;
    </script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="wordmark" href="/" aria-label="Doğuş Köksal home"><img class="wordmark-icon" src="/favicon.svg" alt="Doğuş Köksal" /></a>
        <nav class="desktop-nav" aria-label="Primary navigation">
          <a href="/" class={Astro.url.pathname === '/' ? 'active' : undefined}>Home</a>
          <a href="/work" class={Astro.url.pathname.startsWith('/work') ? 'active' : undefined}>Work</a>
        </nav>
        <div class="header-actions">
          <details class="theme-switcher">
            <summary aria-label="Choose theme" title="Choose theme"><svg class="theme-icon" viewBox="0 0 24 24" aria-hidden="true"><g class="theme-sun"><circle cx="12" cy="12" r="3.5"></circle><path d="M12 2.5v2M12 19.5v2M4.58 4.58l1.42 1.42M18 18l1.42 1.42M2.5 12h2M19.5 12h2M4.58 19.42 6 18M18 6l1.42-1.42"></path></g><path class="theme-moon" d="M20 15.2A8.3 8.3 0 0 1 8.8 4a8.3 8.3 0 1 0 11.2 11.2Z"></path></svg><span class="sr-only">Theme</span></summary>
            <div class="theme-menu" aria-label="Theme preference">
              <button type="button" data-theme-choice="system">System</button>
              <button type="button" data-theme-choice="light">Light</button>
              <button type="button" data-theme-choice="dark">Dark</button>
            </div>
          </details>
          <a class="header-contact email-icon-link" href="mailto:doguskoksl@gmail.com" aria-label="Email" title="Email"><svg class="email-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1.5"></rect><path d="m4 7 8 6 8-6"></path></svg><span class="sr-only">Email</span></a><a class="resume-link" href="/resume/Dogus-Koksal-Resume.pdf" download>Resume</a>
        </div>
        <div class="mobile-controls">
          <details class="mobile-theme-switcher theme-switcher">
            <summary aria-label="Choose theme" title="Choose theme"><svg class="theme-icon" viewBox="0 0 24 24" aria-hidden="true"><g class="theme-sun"><circle cx="12" cy="12" r="3.5"></circle><path d="M12 2.5v2M12 19.5v2M4.58 4.58l1.42 1.42M18 18l1.42 1.42M2.5 12h2M19.5 12h2M4.58 19.42 6 18M18 6l1.42-1.42"></path></g><path class="theme-moon" d="M20 15.2A8.3 8.3 0 0 1 8.8 4a8.3 8.3 0 1 0 11.2 11.2Z"></path></svg><span class="sr-only">Theme</span></summary>
            <div class="theme-menu" aria-label="Theme preference">
              <button type="button" data-theme-choice="system">System</button>
              <button type="button" data-theme-choice="light">Light</button>
              <button type="button" data-theme-choice="dark">Dark</button>
            </div>
          </details>
          <a class="header-contact email-icon-link" href="mailto:doguskoksl@gmail.com" aria-label="Email" title="Email"><svg class="email-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1.5"></rect><path d="m4 7 8 6 8-6"></path></svg><span class="sr-only">Email</span></a>
          <details class="menu-switcher">
            <summary aria-label="Open menu" title="Open menu"><span class="menu-icon" aria-hidden="true"><i></i><i></i><i></i></span><span class="sr-only">Menu</span></summary>
            <nav class="mobile-nav" aria-label="Mobile navigation">
              <a href="/" class={Astro.url.pathname === '/' ? 'active' : undefined}>Home</a>
              <a href="/work" class={Astro.url.pathname.startsWith('/work') ? 'active' : undefined}>Work</a>
              <a class="resume-link" href="/resume/Dogus-Koksal-Resume.pdf" download>Resume</a>
            </nav>
          </details>
        </div>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <div class="footer-meta"><span>Doğuş Köksal</span><span>© 2026</span></div>
        <span class="footer-tagline">Learning in public, one project at a time.</span>
      </div>
    </footer>
    <script is:inline>
      const root = document.documentElement;
      const themeButtons = document.querySelectorAll('[data-theme-choice]');
      const resolveTheme = (preference) => preference === 'system' ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : preference;
      const applyTheme = (preference) => {
        localStorage.setItem('theme-preference', preference);
        root.dataset.themePreference = preference;
        root.dataset.theme = resolveTheme(preference);
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', root.dataset.theme === 'dark' ? '#1c1d1a' : '#f2f0eb');
      };
      themeButtons.forEach((button) => button.addEventListener('click', () => applyTheme(button.dataset.themeChoice)));
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener?.('change', () => {
        if (root.dataset.themePreference === 'system') applyTheme('system');
      });

    </script>
  </body>
</html>
